{
  "name": "v4",
  "description": "Personal Website V4",
  "version": "1.0.0",
  "author": "Brittany Chiang <brittany.chiang@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/bchiang7/v4"
  },
  "keywords": [
    "nextjs"
  ],
  "license": "MIT",
  "browserslist": "> 0.25%, not dead",
  "scripts": {
    "predev": "node scripts/prepare-assets.cjs",
    "dev": "next dev --webpack --port 8000",
    "develop": "npm run dev",
    "prebuild": "node scripts/prepare-assets.cjs",
    "build": "next build --webpack",
    "postbuild": "node scripts/build-offline.cjs",
    "start": "npm run dev",
    "serve": "next start --port 8000",
    "clean": "node scripts/clean.cjs",
    "test": "node --test tests/content.test.cjs",
    "lint": "eslint src scripts tests next.config.js prettier.config.js --ext .js,.cjs",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css}\" \"scripts/**/*.cjs\"",
    "prepare": "husky install",
    "lint-staged": "lint-staged",
    "test:browser": "node tests/browser.cjs"
  },
  "lint-staged": {
    "*.{js,css,json,md}": [
      "prettier --write"
    ],
    "*.js": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "animejs": "3.2.1",
    "gray-matter": "4.0.3",
    "hast-util-raw": "6.1.0",
    "hast-util-to-html": "7.1.3",
    "lodash": "4.17.21",
    "mdast-util-to-hast": "10.2.0",
    "next": "16.4.2",
    "prismjs": "1.27.0",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-transition-group": "4.4.1",
    "remark": "13.0.0",
    "remark-footnotes": "3.0.0",
    "remark-gfm": "1.0.0",
    "scrollreveal": "4.0.9",
    "sharp": "^0.34.0",
    "styled-components": "5.3.11",
    "unist-util-visit": "2.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.14.0",
    "@babel/eslint-parser": "^7.13.14",
    "@babel/preset-react": "^7.13.13",
    "@upstatement/eslint-config": "^1.0.0",
    "@upstatement/prettier-config": "^1.0.0",
    "eslint": "^7.25.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-react": "^7.23.2",
    "husky": "^6.0.0",
    "lint-staged": "^10.1.2",
    "playwright": "^1.64.1",
    "prettier": "^2.2.1"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
